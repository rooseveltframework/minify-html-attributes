{
  "name": "minify-html-attributes",
  "description": "💫 Minifies HTML attribute class names, IDs, and data-* attributes in a coordinated fashion across your HTML, CSS, and JS files. ",
  "author": "Roosevelt Framework Team <rooseveltframework@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/rooseveltframework/minify-html-attributes/graphs/contributors"
    }
  ],
  "version": "1.1.1",
  "homepage": "https://rooseveltframework.org/docs/minify-html-attributes/latest",
  "license": "CC-BY-4.0",
  "main": "minify-html-attributes.js",
  "files": [
    "minify-html-attributes.js",
    "lib/",
    "*.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "standard": "17.1.2"
  },
  "standard": {
    "ignore": [
      "dist/",
      "sampleApps/express/public/",
      "sampleApps/express/.preprocessed_statics/",
      "sampleApps/express/mvc/.preprocessed_views/"
    ]
  },
  "scripts": {
    "lint": "standard",
    "lint-fix": "standard --fix",
    "pretest": "node scripts/prepareSampleApp.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test-unit": "node --test \"test/unit/*.test.js\"",
    "precoverage": "node scripts/prepareSampleApp.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"sampleApps/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=99 --test-coverage-branches=85 --test-coverage-functions=85 \"test/**/*.test.js\"",
    "express-sample": "node -e \"process.chdir('sampleApps/express'); require('./sampleApps/express/server.js')\"",
    "sample": "npm run express-sample"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/minify-html-attributes.git"
  },
  "keywords": [
    "minifier",
    "minification",
    "minify html attributes",
    "html",
    "attributes",
    "class",
    "id",
    "data attributes",
    "html minifier",
    "html obfuscation",
    "obfuscation",
    "obfuscator"
  ],
  "funding": "https://www.paypal.com/donate/?hosted_button_id=2L2X8GRXZCGJ6"
}
